# Vorlage fuer .env. Plattformsuebergreifend initialisieren mit:
#   python scripts/init-env.py
# Windows-PowerShell-Wrapper: scripts\init-env.ps1
# .env niemals committen (steht in .gitignore).

# --- Versionen (fest gepinnt, kein "latest") ---
N8N_VERSION=2.47.7
POSTGRES_VERSION=17.12

# --- PostgreSQL ---
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=GENERATE_ME

# --- n8n ---
# Schluessel fuer gespeicherte Credentials. NIE aendern oder verlieren!
N8N_ENCRYPTION_KEY=GENERATE_ME
N8N_PORT=5678
TZ=Europe/Berlin
GENERIC_TIMEZONE=Europe/Berlin

# --- Host-Updater ---
UPDATER_TOKEN=GENERATE_ME
UPDATER_HOST=127.0.0.1
UPDATER_PORT=5680

# --- Backups ---
BACKUP_RETENTION_DAYS=30
BACKUP_KEEP_MIN=5
MIN_FREE_GB=5
